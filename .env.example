# DeCrypt Environment Configuration Template
# Copy this file to .env and populate with your authorized credentials.
# NEVER commit real private keys, API secrets, or passwords into source control.

# ==============================================================================
# 1. DATABASE & CACHE STORAGE
# ==============================================================================
# SQLite default: sqlite:///./decrypt_storage.db
# PostgreSQL production: postgresql://decrypt_user:secure_password@localhost:5432/decrypt_db
DECRYPT_DATABASE_URL=sqlite:///./decrypt_storage.db

# ==============================================================================
# 2. FASTAPI INGESTION SERVICE
# ==============================================================================
DECRYPT_HOST=0.0.0.0
DECRYPT_PORT=8000
DECRYPT_RATE_LIMIT_RPM=600
DECRYPT_LOG_LEVEL=INFO

# ==============================================================================
# 3. TRADITIONAL BANKING (PLAID SANDBOX)
# ==============================================================================
# Register at https://dashboard.plaid.com/signup for free Sandbox keys
# Note: Plaid Sandbox targets US/CA/UK/EU banking and does NOT provide real Indian bank data.
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_sandbox_secret_here
PLAID_ENV=sandbox
PLAID_WEBHOOK_SECRET=your_plaid_webhook_verification_token_here
PLAID_SAMPLE_ACCESS_TOKEN=access-sandbox-de3ce8ef-33f8-452c-a685-da52b0938d40

# ==============================================================================
# 4. EVM CRYPTOCURRENCY (ALCHEMY)
# ==============================================================================
# Register at https://www.alchemy.com/ for free Ethereum/EVM node access
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_NETWORK=eth-mainnet
# Webhook signing key from Alchemy Notify dashboard (used for HMAC-SHA256 verification)
ALCHEMY_WEBHOOK_SIGNING_KEY=whsec_your_alchemy_webhook_signing_key_here

# ==============================================================================
# 5. BITCOIN SETTLEMENT (BLOCKSTREAM / MEMPOOL.SPACE)
# ==============================================================================
# Public Esplora instance: https://mempool.space/api or https://blockstream.info/api
BITCOIN_ESPLORA_URL=https://mempool.space/api
BITCOIN_NETWORK=bitcoin
BITCOIN_API_KEY=optional_enterprise_api_key_here

# ==============================================================================
# 6. MODEL HYPERPARAMETERS & THRESHOLDS
# ==============================================================================
MODEL_DIR=output
ENSEMBLE_WEIGHT_IF=0.8
ENSEMBLE_WEIGHT_TF=0.2
HIGH_RISK_THRESHOLD=90.0
MIN_SEQUENCE_LENGTH=3
LARGE_TX_MULTIPLIER=3.0
